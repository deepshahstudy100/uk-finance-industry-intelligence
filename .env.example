# ---------------------------------------------------------------------------------------------
# UK National Finance & Industry Intelligence Platform - environment template
# Copy to .env (root, used by docker compose) and/or backend/.env (local dev).
# Nothing here is required to be paid for. All keys are optional and free.
# ---------------------------------------------------------------------------------------------

# Database. Docker compose overrides this to point at its PostgreSQL service.
# Local dev without Docker: SQLite works out of the box.
UKINTEL_DATABASE_URL=sqlite:///./ukintel.db
POSTGRES_USER=ukintel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ukintel

# Identify your deployment to public APIs (ONS asks for a bot name/version and an organisational
# contact URL or email - do not put personal data here). Replace the URL with your project page.
UKINTEL_USER_AGENT=UKIntelPlatform/0.1.0 (+https://github.com/deepshahstudy100/uk-finance-industry-intelligence)

# Demo mode: off | fallback | only
#   fallback = labelled synthetic sample data ONLY for series with no real observations retrieved.
UKINTEL_DEMO_MODE=fallback

# Optional free keys
# Companies House: register at https://developer.company-information.service.gov.uk/ (REST key)
UKINTEL_COMPANIES_HOUSE_API_KEY=
# NOMIS: optional uid lifts the 25,000-cell guest limit (not needed for the default queries)
UKINTEL_NOMIS_UID=

# BoE spot FX (XUDL*) can contain third-party content with redistribution restrictions.
# Leave false unless your use is permitted; ECB reference rates are used instead.
UKINTEL_ENABLE_BOE_FX=false

# If set, POST /api/sources/{id}/refresh requires header X-Admin-Token with this value.
# Strongly recommended for any deployment reachable from the internet.
UKINTEL_ADMIN_TOKEN=

# Comma-separated origins allowed to call the API directly (the web UI uses a same-origin proxy).
UKINTEL_CORS_ORIGINS=http://localhost:3000

# Frontend: optional free basemap style URL (default: none - boundaries only, no third-party tiles).
# Example: https://tiles.openfreemap.org/styles/dark  (check the provider's terms before use)
NEXT_PUBLIC_BASEMAP_STYLE=
